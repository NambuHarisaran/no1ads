# Web3Forms access key for the contact form.
# 1. Go to https://web3forms.com, enter contact@no1ads.in, and get a free Access Key.
# 2. Copy this file to .env.local and paste the key below.
# 3. On Vercel, add VITE_WEB3FORMS_KEY in Project Settings → Environment Variables.
VITE_WEB3FORMS_KEY=your-access-key-here

# ── Analytics (both optional) ────────────────────────────────────────────────
# Leave blank to disable. When set, the snippet is injected on every page and
# conversion events (leads, calls, WhatsApp, email, CTA clicks) are tracked.

# Google Analytics 4 Measurement ID — analytics.google.com → Admin → Data Streams.
VITE_GA_ID=

# Microsoft Clarity project ID (heatmaps + session recordings) — clarity.microsoft.com.
VITE_CLARITY_ID=
